# ── Servidor ──────────────────────────────────────────────────────────────────
BFF_PORT=3000
CORS_ORIGINS=http://localhost:4200

# ── Persistência MongoDB ──────────────────────────────────────────────────────
# Habilita a gravação de série temporal no MongoDB
MONGO_ENABLED=true
MONGO_URI=mongodb://localhost:27017/javamelody

# URL da API REST de histórico (NestJS) — informada ao Angular via GET /config
HISTORY_API_URL=http://localhost:3001

# Intervalo de polling em ms (padrão 30s)
POLL_INTERVAL_MS=30000
ANTHROPIC_API_KEY=your-key-here