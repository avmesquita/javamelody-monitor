# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=mongopass

# ── Mongo Express (UI admin — só com --profile debug) ─────────────────────────
MONGOEXPRESS_USER=admin
MONGOEXPRESS_PASS=mongoexpresspass

# ── BFF ────────────────────────────────────────────────────────────────────────
MONGO_ENABLED=true
POLL_INTERVAL_MS=30000

# ── CORS — origens permitidas pelo BFF e pela API ─────────────────────────────
# Em produção substitua pelo domínio real do frontend
CORS_ORIGINS=http://localhost:4200

# ── IA — Análise de erros (Catálogo) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sua_chave_aqui
